<Window x:Class="PasswordGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGenerator"
        mc:Ignorable="d"
        Title="Generator Haseł" 
        Height="680" Width="490"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Styl dla przycisków głównych -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla przycisków pomocniczych -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla CheckBox -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Nagłówek -->
            <RowDefinition Height="Auto"/> <!-- Karta z hasłem -->
            <RowDefinition Height="*"/>    <!-- Karta z opcjami -->
            <RowDefinition Height="Auto"/> <!-- Przycisk Generuj -->
            <RowDefinition Height="Auto"/> <!-- Stopka -->
        </Grid.RowDefinitions>

        <!-- 1. NAGŁÓWEK -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="10" Background="#6366F1" Margin="0,0,12,0">
                <TextBlock Text="🔐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Generator Haseł" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Generuj bezpieczne i trudne do złamania hasła" FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>
        </StackPanel>

        <!-- 2. KARTA Z WYGENEROWANYM HASŁEM -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <!-- Pole hasła -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtPassword" 
                             Grid.Column="0"
                             Text="Kliknij Generuj" 
                             IsReadOnly="True" 
                             Background="#0B1120" 
                             Foreground="#38BDF8" 
                             FontFamily="Consolas, Cascadia Code, Courier New" 
                             FontSize="16" 
                             FontWeight="Bold" 
                             Padding="12,10" 
                             BorderBrush="#334155" 
                             BorderThickness="1" 
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             MaxHeight="80"
                             VerticalScrollBarVisibility="Auto"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="btnCopy" Content="📋 Kopiuj" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnCopy_Click" 
                                Height="40" Padding="12,0" Margin="0,0,6,0"
                                ToolTip="Kopiuj do schowka"/>
                        <Button x:Name="btnRefresh" Content="🔄" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Click="BtnGenerate_Click" 
                                Height="40" Width="40" Padding="0"
                                ToolTip="Wygeneruj inne hasło"/>
                    </StackPanel>
                </Grid>

                <!-- Komunikat o skopiowaniu (toast) -->
                <TextBlock x:Name="lblCopyStatus" 
                           Text="✓ Skopiowano do schowka!" 
                           Foreground="#10B981" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Visibility="Collapsed" 
                           Margin="0,0,0,6"/>

                <!-- Wskaźnik siły hasła -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Siła hasła:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <ProgressBar x:Name="pbStrength" 
                                 Grid.Column="1" 
                                 Height="8" 
                                 Minimum="0" 
                                 Maximum="100" 
                                 Value="0" 
                                 Foreground="#10B981" 
                                 Background="#0B1120" 
                                 BorderThickness="0"
                                 VerticalAlignment="Center"/>

                    <TextBlock x:Name="lblStrength" 
                               Grid.Column="2" 
                               Text="—" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Foreground="#10B981" 
                               VerticalAlignment="Center" 
                               Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. KARTA Z OPCJAMI -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Wybór długości -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Długość hasła" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#334155" CornerRadius="6" Padding="8,3">
                            <TextBlock x:Name="lblLength" 
                                       Text="{Binding ElementName=sliderLength, Path=Value, StringFormat={}{0:0} znaków}" 
                                       Foreground="#38BDF8" 
                                       FontWeight="Bold" 
                                       FontSize="13"/>
                        </Border>
                    </Grid>

                    <Slider x:Name="sliderLength" 
                            Minimum="4" 
                            Maximum="64" 
                            Value="16" 
                            TickFrequency="1" 
                            IsSnapToTickEnabled="True" 
                            ValueChanged="OptionChanged" 
                            Margin="0,6,0,14"
                            Foreground="#6366F1"/>

                    <Separator Background="#334155" Margin="0,0,0,10"/>

                    <!-- Opcje znaków -->
                    <TextBlock Text="Zawartość hasła" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,4"/>

                    <CheckBox x:Name="chkUppercase" 
                              Content="Wielkie litery (A, B, C, ...)" 
                              IsChecked="True" 
                              Style="{StaticResource ModernCheckBoxStyle}" 
                              Click="OptionChanged"/>

                    <CheckBox x:Name="chkLowercase" 
                              Content="Małe litery (a, b, c, ...)" 
                              IsChecked="True" 
                              Style="{StaticResource ModernCheckBoxStyle}" 
                              Click="OptionChanged"/>

                    <CheckBox x:Name="chkNumbers" 
                              Content="Cyfry (0, 1, 2, 3, ...)" 
                              IsChecked="True" 
                              Style="{StaticResource ModernCheckBoxStyle}" 
                              Click="OptionChanged"/>

                    <CheckBox x:Name="chkSpecial" 
                              Content="Znaki specjalne (!, @, #, $, %, ...)" 
                              IsChecked="True" 
                              Style="{StaticResource ModernCheckBoxStyle}" 
                              Click="OptionChanged"/>

                    <CheckBox x:Name="chkExcludeAmbiguous" 
                              Content="Wyklucz mylące znaki (np. 1, l, I, 0, O)" 
                              IsChecked="False" 
                              Style="{StaticResource ModernCheckBoxStyle}" 
                              Click="OptionChanged"/>

                    <!-- Ostrzeżenie jeśli brak wybranych opcji -->
                    <TextBlock x:Name="lblWarning" 
                               Text="⚠️ Wybierz co najmniej jeden zestaw znaków!" 
                               Foreground="#EF4444" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Visibility="Collapsed" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 4. GŁÓWNY PRZYCISK GENEROWANIA -->
        <Button Grid.Row="3" 
                x:Name="btnGenerate" 
                Content="⚡ Generuj Nowe Hasło" 
                Style="{StaticResource PrimaryButtonStyle}" 
                Height="44" 
                FontSize="15" 
                Click="BtnGenerate_Click"
                Margin="0,0,0,10"/>

        <!-- 5. STOPKA -->
        <TextBlock Grid.Row="4" 
                   Text="Generowanie kryptograficznie bezpieczne (RNG). 100% lokalnie." 
                   FontSize="11" 
                   Foreground="#64748B" 
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>
